# Required for Anthropic models, Anthropic judges, coding hand-offs and recaps; otherwise optional.
ANTHROPIC_API_KEY=
# Required for OpenRouter models, the judges (every default judge is an OpenRouter model) and consultations of other models.
OPENROUTER_API_KEY=
# Required for custom/ models: the bearer for the OpenAI-compatible endpoint SHAFT_CUSTOM_BASE_URL (any value for a server that checks none); otherwise optional.
SHAFT_CUSTOM_API_KEY=
# Required for the broker's web search; otherwise optional.
SCRAPEBADGER_API_KEY=
# Required for the chat API and its web/Telegram clients; generated by bin/shaft api on.
SHAFT_API_KEY=
# Optional separate credential for inbox submissions; generated by bin/shaft api on or bin/shaft api inbox-key.
SHAFT_INBOX_KEY=
# Required for the API/web UI: comma-separated Tailscale logins, not a secret; bin/shaft api on records yours (api on --local adds operator@local, the Mac app's login on this Mac).
SHAFT_API_LOGINS=
# Optional Telegram bot token; replace NAME with the uppercase instance name, replacing hyphens with underscores.
TELEGRAM_TOKEN_NAME=
# Required only for Google integrations; replace CLIENT with the uppercase OAuth client name, replacing hyphens with underscores.
GMAIL_CLIENT_CLIENT_ID=
# Required with that Google client ID for Gmail, Calendar or instance-owned Gmail/Drive access; use the same CLIENT name.
GMAIL_CLIENT_CLIENT_SECRET=
