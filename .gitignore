# my mind: versioned by the supervisor in my private mind store, never in this repository
/self/
/memory/
/notes/
/inbox/
# runtime artefacts (not part of an agent's mind or code)
logs/
.tmp/
# my Python environment: rebuilt from .python-version and requirements.txt
.venv/
.uv/
__pycache__/
.DS_Store
# my keys: handled by the supervisor, never committed
secrets/
# attachments downloaded from the operator's mail (mail_attachment): copies of his mail, never committed
mail/
gdrive/
gchat/
# my scheduled jobs' own state (.jobs/<plugin>/): a cache the job keeps between runs, never committed
.jobs/

# my browser profile (.browser/): my sessions and the passwords of my own accounts, never committed or copied
.browser/
