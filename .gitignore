# secrets
.env
# the operator's private records (reviews and bake-off reports on live instances): kept on this Mac, never published
/private/
# runtime artefacts
.supervisor/
**/logs/
**/.tmp/
__pycache__/
.DS_Store

# branch worktrees (template, instance/<name>) — see supervisor/__main__.py
/template/
/instances/

# fine-tuning toolchain (M6), not part of the supervisor
/.venv-ft/
/.models/
/.venv-bonsai/
/.venv-ui/

# the Chromium every instance browses with (shaft browser install); .new/.old while it is replaced
/.browsers/
/.browsers.new/
/.browsers.old/

