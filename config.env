# SHAFT instance configuration — KEY=VALUE, no shell syntax.
# Precedence: environment variable > this file > built-in default.
# The instance may edit this file itself; network access is decided by the
# supervisor (SHAFT_LLM_PORTS), not here.

LLM_BASE_URL="http://127.0.0.1:1337/v1"
LLM_MODEL="prism-ml/prism-ml/Ternary-Bonsai-2-27B-PQ2_0"
LLM_API_KEY=""

# Thinking models spend hidden reasoning tokens from the same budget as the answer.
MAX_TOKENS_REFLECT=8192
MAX_TOKENS_TALK=4096
LLM_TIMEOUT_S=900

# How much of the journal (newest first) goes into each prompt.
CONTEXT_JOURNAL_CHARS=16000

OPERATOR_NAME="Daniele"
