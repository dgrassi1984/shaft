# SHAFT instance configuration — KEY=VALUE, no shell syntax.
# Precedence: environment variable > this file > built-in default.
# The instance changes a value with the supervisor's set_config tool (it cannot write this file
# directly); network access is decided by the supervisor (SHAFT_LLM_PORTS), not here.

# A local OpenAI-compatible server, or "broker" for a model the supervisor reaches for me: a cloud model
# (allowed models: SHAFT_CLOUD_MODELS, e.g. LLM_MODEL="claude-haiku-5-5"; the key stays with the supervisor) or a
# self-hosted server (SHAFT_SELF_HOSTED, e.g. LLM_MODEL="racer/bonsai2"; the local Bonsai answers if it is off).
LLM_BASE_URL="http://127.0.0.1:8780/v1"          # SHAFT's own Bonsai 2 server (shaft model on)
LLM_MODEL="ternary-bonsai-2-27b-mlx"
LLM_API_KEY=""
# Presence penalty in tenths (15 = 1.5): Qwen's advice against endless repetition in quantized models.
# How hard I think on the local model: "medium" scales thinking to the request (117-1,234 reasoning tokens in
# tests); "xhigh" thinks until the server cuts it off (4,096) on anything non-trivial; "low" is brief.
LLM_REASONING_EFFORT="medium"
# How often the supervisor wakes me for an autonomous cycle, in minutes (at least 10; 0 = never). A wake
# that comes while I am already awake (a cycle, a conversation, my sleep) is skipped.
WAKE_INTERVAL_MINUTES=120
# The model's context window, for the talk client's status bar (Bonsai 2: 262,144 tokens).
LLM_CONTEXT_TOKENS=262144
LLM_PRESENCE_PENALTY=15

# Thinking models spend hidden reasoning tokens from the same budget as the answer.
# Measured 2026-10-12 on Bonsai 27B: a reflection used 8192 on reasoning alone, then 7227 in total.
MAX_TOKENS_REFLECT=16384
MAX_TOKENS_TALK=16384   # measured 2026-10-12: a talk reply used all 4096 on thinking; 2026-10-28 (mimo-v2.6-pro):
                        # recapping a 77 KB transcript used all 8192, then all 16384 of the retry, on thinking
# Measured 2026-10-12 (a sleep cycle): at ~17k prompt tokens a single step needed 10-15k tokens.
MAX_TOKENS_STEP=16384

# Model turns per cycle when using tools.
MAX_STEPS_LIVE=12
MAX_STEPS_SLEEP=30
MAX_STEPS_TALK=0   # no limit in conversations: Ctrl-C stops a reply
LLM_TIMEOUT_S=900

# How much of the journal (newest first) goes into each prompt.
CONTEXT_JOURNAL_CHARS=16000

# My watchers write this dated briefing as a scheduled job; the live prompt reads it before I choose a goal.
# Include calendar next 48 h, actionable mail, open commitments to the operator and his last corrections, dated.
# A first line 'generated: <ISO time>' dates it; otherwise its mtime does. 'off' hides it.
BRIEFING="notes/briefing.md"
# My last two live cycles' handoffs: on = structured; raw = tool log at the same character budget; off = hidden.
HANDOFF="on"

# Curiosity cycles: while I have open surprises, one live cycle in this many (drawn at random) takes its goal from
# them; 0 = never. A message from the operator waiting in my inbox always comes first.
CURIOSITY_EVERY_CYCLES=5

# Set your name here; leave empty to use "the operator".
OPERATOR_NAME=""
